# Pfad zum Ollama-Modellverzeichnis, identisch zu ai-stack/.env.
# Backslash-UNC-Form ist Pflicht: docker compose liest .env verbatim, waehrend
# Forward-Slashes hier nicht als Bind-Mount aufgeloest werden.
OLLAMA_MODELS_PATH=\wsl.localhost\Ubuntu\home\crack\ai-models\ollama-models

# Startwert; run_matrix.sh ueberschreibt ihn je Messreihe.
OLLAMA_KV_CACHE_TYPE=q8_0
